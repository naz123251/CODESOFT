import random

def rock_paper_scissors_game():
    """
    Rock-Paper-Scissors game with score tracking and replay functionality
    """
    # Initialize scores
    user_score = 0
    computer_score = 0
    ties = 0
    
    # Game choices
    choices = ["rock", "paper", "scissors"]
    
    print("=" * 50)
    print("      WELCOME TO ROCK-PAPER-SCISSORS GAME!")
    print("=" * 50)
    
    while True:
        print(f"\nCurrent Score - You: {user_score} | Computer: {computer_score} | Ties: {ties}")
        print("-" * 30)
        
        # User input
        while True:
            user_choice = input("Choose rock, paper, or scissors: ").lower().strip()
            if user_choice in choices:
                break
            else:
                print("Invalid choice! Please enter rock, paper, or scissors.")
        
        # Computer selection
        computer_choice = random.choice(choices)
        
        # Display choices
        print(f"\nYour choice: {user_choice}")
        print(f"Computer's choice: {computer_choice}")
        
        # Game logic
        if user_choice == computer_choice:
            print("It's a tie!")
            ties += 1
        elif (user_choice == "rock" and computer_choice == "scissors") or \
             (user_choice == "scissors" and computer_choice == "paper") or \
             (user_choice == "paper" and computer_choice == "rock"):
            print("You win!")
            user_score += 1
        else:
            print("Computer wins!")
            computer_score += 1
        
        # Ask to play again
        while True:
            play_again = input("\nDo you want to play another round? (yes/no): ").lower().strip()
            if play_again in ["yes", "y", "no", "n"]:
                break
            else:
                print("Please enter 'yes' or 'no'.")
        
        if play_again in ["no", "n"]:
            print("\n" + "=" * 50)
            print("             FINAL SCORE")
            print(f"You: {user_score} | Computer: {computer_score} | Ties: {ties}")
            
            if user_score > computer_score:
                print("Congratulations! You won the game!")
            elif computer_score > user_score:
                print("Computer won the game. Better luck next time!")
            else:
                print("The game ended in a tie!")
            
            print("Thanks for playing!")
            print("=" * 50)
            break

# Run the game
if __name__ == "__main__":
    rock_paper_scissors_game()